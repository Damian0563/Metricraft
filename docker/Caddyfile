# Path-based routing for the dashboard (UI + API/WebSocket on one public hostname).
# Set DOMAIN and ALLOWED_ORIGINS to this host, e.g. http://localhost or https://metrics.example.com.
:80 {
	@api path /sign /dashboard/* /settings/* /verify/* /ws/*
	handle @api {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy metricraft:8000
	}
}

# Optional: expose the worker proxy on a separate hostname for captured app traffic.
# Point your upstream app (or its ingress) at this host, or use worker:8081 inside the Docker network.
:8081 {
	reverse_proxy worker:8081
}
